[gd_resource type="Resource" script_class="AbilityData" format=3 uid="uid://lmun83uvc8xw"]

[ext_resource type="Script" uid="uid://crxnpxb4fci0f" path="res://scripts/data/ability_data.gd" id="1_ab"]
[ext_resource type="Script" uid="uid://bgp64ty0hqbey" path="res://scripts/data/effect_spec.gd" id="2_spec"]
[ext_resource type="Script" uid="uid://bhmtkvq6m1e37" path="res://scripts/data/effect_action.gd" id="3_act"]

[sub_resource type="Resource" id="Resource_act_perm_crit"]
script = ExtResource("3_act")
action_type = 6
stat_name = &"crit_rate_percent"
value = 5

[sub_resource type="Resource" id="Resource_spec_hurt"]
script = ExtResource("2_spec")
trigger = &"OnDamageTaken"
actions = Array[ExtResource("3_act")]([SubResource("Resource_act_perm_crit")])

[sub_resource type="Resource" id="Resource_act_crit_buff"]
script = ExtResource("3_act")
stat_name = &"crit_rate_percent"
value = 10

[sub_resource type="Resource" id="Resource_spec_crit"]
script = ExtResource("2_spec")
trigger = &"OnCrit"
actions = Array[ExtResource("3_act")]([SubResource("Resource_act_crit_buff")])

[resource]
script = ExtResource("1_ab")
id = "gunner_dual_crit"
display_name = "受伤时 永久 +5% 暴击；造成暴击时 +10% 暴击"
